<Project Sdk="Microsoft.NET.Sdk">

	<PropertyGroup>
		<PackageId>FluentLocalizer.Extensions.DependencyInjection</PackageId>
		<Product>FluentLocalizer.Extensions.DependencyInjection</Product>
		<RootNamespace>FluentLocalizer.Core</RootNamespace>
		<Version>1.0.0</Version>
		<Description>
			Dependency injection extensions for registering FluentLocalizer translators, stores, and logging services in .NET applications.
		</Description>
		<PackageTags>dependencyinjection;di;localization;translation;dotnet;services</PackageTags>
		<GenerateDependencyFile>false</GenerateDependencyFile>
	</PropertyGroup>

	<ItemGroup>
		<PackageReference Include="Microsoft.Extensions.DependencyInjection.Abstractions" Version="10.0.12" />
		<PackageReference Include="Microsoft.Extensions.Logging.Abstractions" Version="10.0.12" />
		<PackageReference Include="Microsoft.Extensions.Options" Version="10.0.12" />
	</ItemGroup>

	<ItemGroup>
		<ProjectReference Include="..\FluentLocalizer.Core\FluentLocalizer.Core.csproj" />
	</ItemGroup>

	<Import Project="..\FluentLocalizer.Shared.Polyfill\FluentLocalizer.Shared.Polyfill.projitems" Label="Shared" />

</Project>
