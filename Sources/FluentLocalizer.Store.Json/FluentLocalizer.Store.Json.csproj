<Project Sdk="Microsoft.NET.Sdk">
	<PropertyGroup>
		<PackageId>FluentLocalizer.Store.Json</PackageId>
		<Product>FluentLocalizer.Store.Json</Product>
		<Version>1.1.0</Version>
		<Description>JSON translation stores for FluentLocalizer with culture-aware loading from files, embedded resources, or HTTP.</Description>
		<PackageReleaseNotes>EmbeddedJsonStore reads namespace files such as it.common.json and can parse each file on first use with EmbeddedJsonStoreOptions.LoadOnDemand. Embedded resources are parsed straight from the resource stream, and nested-key lookups in every JSON store no longer allocate per segment.</PackageReleaseNotes>
		<PackageTags>json;http;localization;translation;store;icu;dotnet</PackageTags>
		<GenerateDependencyFile>false</GenerateDependencyFile>
	</PropertyGroup>

	<ItemGroup>
		<PackageReference Include="System.Text.Json" Version="10.0.12" Condition="'$(TargetFramework)' == 'netstandard2.0'" />
	</ItemGroup>

	<ItemGroup>
		<ProjectReference Include="..\FluentLocalizer.Core\FluentLocalizer.Core.csproj" />
	</ItemGroup>

	<Import Project="..\FluentLocalizer.Shared.Polyfill\FluentLocalizer.Shared.Polyfill.projitems" Label="Shared" />

</Project>
