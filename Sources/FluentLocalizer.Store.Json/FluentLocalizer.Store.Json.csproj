<Project Sdk="Microsoft.NET.Sdk">
	<PropertyGroup>
		<PackageId>FluentLocalizer.Store.Json</PackageId>
		<Product>FluentLocalizer.Store.Json</Product>
		<Version>0.0.1</Version>
		<Description>
			JSON-backed translation store for FluentLocalizer with culture-aware loading from files or embedded resources.
		</Description>
		<PackageTags>json;localization;translation;store;messageformat;dotnet</PackageTags>
		<GenerateDependencyFile>false</GenerateDependencyFile>
	</PropertyGroup>

	<ItemGroup>
		<PackageReference Include="PolySharp" Version="1.16.0">
			<PrivateAssets>all</PrivateAssets>
			<IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
		</PackageReference>
		<PackageReference Include="System.Text.Json" Version="10.*" Condition="'$(TargetFramework)' == 'netstandard2.0'" />
	</ItemGroup>

	<ItemGroup>
		<Content Include="Assets\readme.txt" Pack="true" PackagePath="readme.txt" />
		<None Include="FluentLocalizer.Store.Json.targets" Pack="true" PackagePath="build\FluentLocalizer.Store.Json.targets" />
	</ItemGroup>

	<ItemGroup>
		<ProjectReference Include="..\FluentLocalizer.Core\FluentLocalizer.Core.csproj" />
	</ItemGroup>

</Project>
