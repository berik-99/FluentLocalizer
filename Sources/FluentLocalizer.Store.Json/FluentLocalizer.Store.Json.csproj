<Project Sdk="Microsoft.NET.Sdk">
	<PropertyGroup>
		<PackageId>FluentLocalizer.Store.Json</PackageId>
		<Product>FluentLocalizer.Store.Json</Product>
		<Version>0.0.1</Version>
		<Description>JSON translation stores for FluentLocalizer with culture-aware loading from files, embedded resources, or HTTP.</Description>
		<PackageTags>json;http;localization;translation;store;messageformat;dotnet</PackageTags>
		<GenerateDependencyFile>false</GenerateDependencyFile>
	</PropertyGroup>

	<ItemGroup>
		<PackageReference Include="System.Text.Json" Version="10.*" Condition="'$(TargetFramework)' == 'netstandard2.0'" />

	</ItemGroup>

	<ItemGroup>
		<Content Include="Assets\readme.txt" Pack="true" PackagePath="readme.txt" />
	</ItemGroup>

	<ItemGroup>

		<ProjectReference Include="..\FluentLocalizer.Polyfill\FluentLocalizer.Polyfill.csproj" />

		<ProjectReference Include="..\FluentLocalizer.Core\FluentLocalizer.Core.csproj" />

	</ItemGroup>

</Project>
