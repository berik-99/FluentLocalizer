@inherits LayoutComponentBase

@inject NavigationManager Navigation
@inject IJSRuntime JS
<a class="skip-link" href="@SkipLinkHref">Skip to content</a>
<header class="site-header">
    <div class="shell header-inner">
        <NavLink class="brand" href="" Match="NavLinkMatch.All" aria-label="FluentLocalizer home">
            <BrandLogo />
            <span>Fluent<span class="brand-accent">Localizer</span></span>
        </NavLink>
        <nav class="main-nav" aria-label="Main navigation">
            <NavLink href="" Match="NavLinkMatch.All">Overview</NavLink>
            <NavLink href="playground">Playground</NavLink>
            <NavLink href="docs">Docs</NavLink>
        </nav>
        <div class="header-actions">
            <Dropdown Id="theme-choice" Class="dropdown-ink theme-choice" AriaLabel="Color theme" Options="ThemeOptions" @bind-Value="_theme" @bind-Value:after="ChangeThemeAsync" />
            <a class="header-github" href="@SiteLinks.Repository" target="_blank" rel="noopener noreferrer" aria-label="View FluentLocalizer on GitHub">GitHub <span aria-hidden="true">↗</span></a>
        </div>
    </div>
</header>

<main id="main-content">@Body</main>

<footer class="site-footer">
    <div class="shell footer-inner">
        <div>
            <span class="footer-brand"><BrandLogo /> FluentLocalizer</span>
            <p>Localization that reads like your code.</p>
        </div>
        <nav class="footer-links" aria-label="Footer">
            <NavLink href="docs">Docs</NavLink>
            <a href="@SiteLinks.Repository" target="_blank" rel="noopener noreferrer">GitHub</a>
            <a href="@SiteLinks.NuGet("FluentLocalizer")" target="_blank" rel="noopener noreferrer">NuGet</a>
            <a href="@SiteLinks.License" target="_blank" rel="noopener noreferrer">MIT License</a>
        </nav>
    </div>
</footer>

@code {
    private static readonly DropdownOption<string>[] ThemeOptions =
        [new("system", "System"), new("light", "Light"), new("dark", "Dark")];

    private string _theme = "system";

    // Drop any fragment already in the address so the link always targets #main-content.
    private string SkipLinkHref => Navigation.ToBaseRelativePath(Navigation.Uri).Split('#')[0] + "#main-content";

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            _theme = await JS.InvokeAsync<string>("fluentSite.getTheme");
            StateHasChanged();
        }
    }

    private async Task ChangeThemeAsync() => await JS.InvokeVoidAsync("fluentSite.setTheme", _theme);
}
