@inherits LayoutComponentBase
@implements IDisposable

@inject NavigationManager Navigation
@inject IJSRuntime JS
<a class="skip-link" href="@SkipLinkHref">@Translator.Get("Ui:Skip")</a>
<header class="site-header">
    <div class="shell header-inner">
        <NavLink class="brand" href="" Match="NavLinkMatch.All" aria-label="@Translator.Get("Ui:HomeLabel")">
            <BrandLogo />
            <span>Fluent<span class="brand-accent">Localizer</span></span>
        </NavLink>
        <nav class="main-nav" aria-label="@Translator.Get("Ui:Navigation")">
            <NavLink href="" Match="NavLinkMatch.All">@Translator.Get("Ui:Overview")</NavLink>
            <NavLink href="playground">@Translator.Get("Ui:Playground")</NavLink>
            <a href="@DocsSets.Latest(DocsSets.DefaultScope).Route" class="@(Section == SiteSection.Docs ? "active" : null)" aria-current="@(Section == SiteSection.Docs ? "page" : null)">@Translator.Get("Ui:Docs")</a>
            <a href="@($"{DocsSets.Latest(DocsSets.DefaultScope).Route}/api")" class="@(Section == SiteSection.Api ? "active" : null)" aria-current="@(Section == SiteSection.Api ? "page" : null)">@Translator.Get("Ui:ApiNav")</a>
            <NavLink href="changelog">@Translator.Get("Ui:ChangelogNav")</NavLink>
        </nav>
        <div class="header-actions">
            <Dropdown TValue="string" Id="language-choice" Class="dropdown-ink language-choice" AriaLabel="@Translator.Get("Ui:Language")" Options="LanguageOptions" Value="@SiteCulture.TwoLetterISOLanguageName" ValueChanged="ChangeLanguageAsync" />
            <Dropdown Id="theme-choice" Class="dropdown-ink theme-choice" AriaLabel="@Translator.Get("Ui:Theme")" Options="ThemeOptions" @bind-Value="_theme" @bind-Value:after="ChangeThemeAsync" />
            <a class="header-github" href="@SiteLinks.Repository" target="_blank" rel="noopener noreferrer" aria-label="@Translator.Get("Ui:SourceCodeLabel")">@Translator.Get("Ui:SourceCode") <span aria-hidden="true">↗</span></a>
        </div>
    </div>
</header>

<main id="main-content"><CascadingValue Value="SiteCulture">@Body</CascadingValue></main>

<footer class="site-footer">
    <div class="shell footer-inner">
        <div>
            <span class="footer-brand"><BrandLogo /> FluentLocalizer</span>
            <p>@Translator.Get("Ui:Tagline")</p>
        </div>
        <nav class="footer-links" aria-label="@Translator.Get("Ui:Footer")">
            <a href="@DocsSets.Latest(DocsSets.DefaultScope).Route">@Translator.Get("Ui:Docs")</a>
            <NavLink href="changelog">@Translator.Get("Ui:ChangelogNav")</NavLink>
            <a href="@SiteLinks.Repository" target="_blank" rel="noopener noreferrer">GitHub</a>
            <a href="@SiteLinks.NuGet("FluentLocalizer")" target="_blank" rel="noopener noreferrer">NuGet</a>
            <a href="@SiteLinks.License" target="_blank" rel="noopener noreferrer">@Translator.Get("Ui:License")</a>
            <a href="@SiteLinks.ThirdPartyNotices" target="_blank" rel="noopener noreferrer">@Translator.Get("Ui:ThirdPartyNotices")</a>
        </nav>
    </div>
</footer>

@code {
    private System.Globalization.CultureInfo SiteCulture { get; set; } = System.Globalization.CultureInfo.CurrentUICulture;

    private static readonly DropdownOption<string>[] LanguageOptions =
        [new("en", "English"), new("it", "Italiano"), new("fr", "Français"), new("de", "Deutsch"), new("es", "Español")];

    private DropdownOption<string>[] ThemeOptions =>
        [new("system", Translator.Get("Ui:System")), new("light", Translator.Get("Ui:Light")), new("dark", Translator.Get("Ui:Dark"))];

    private string _theme = "system";

    private enum SiteSection { Other, Docs, Api }

    // Every documentation set shares the two header links: the API reference of any set, and its guides.
    private SiteSection Section
    {
        get
        {
            var path = Navigation.ToBaseRelativePath(Navigation.Uri).Split('?', '#')[0].TrimEnd('/');
            if (path != "docs" && !path.StartsWith("docs/", StringComparison.Ordinal)) return SiteSection.Other;
            return path.EndsWith("/api", StringComparison.Ordinal) ? SiteSection.Api : SiteSection.Docs;
        }
    }

    protected override void OnInitialized() => Navigation.LocationChanged += OnLocationChanged;

    private void OnLocationChanged(object? sender, Microsoft.AspNetCore.Components.Routing.LocationChangedEventArgs e) => StateHasChanged();

    public void Dispose() => Navigation.LocationChanged -= OnLocationChanged;

    // Drop any fragment already in the address so the link always targets #main-content.
    private string SkipLinkHref => Navigation.ToBaseRelativePath(Navigation.Uri).Split('#')[0] + "#main-content";

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            _theme = await JS.InvokeAsync<string>("fluentSite.getTheme");
            StateHasChanged();
        }
    }

    private async Task ChangeThemeAsync() => await JS.InvokeVoidAsync("fluentSite.setTheme", _theme);

    private async Task ChangeLanguageAsync(string language)
    {
        SiteCulture = BrowserCulture.SelectCulture([language]);
        System.Globalization.CultureInfo.DefaultThreadCurrentCulture = SiteCulture;
        System.Globalization.CultureInfo.DefaultThreadCurrentUICulture = SiteCulture;
        await JS.InvokeVoidAsync("fluentSite.saveLanguage", SiteCulture.TwoLetterISOLanguageName);
        await JS.InvokeVoidAsync("fluentSite.setLanguage", SiteCulture.Name, new
        {
            loading = Translator.Get("Ui:Loading").Resolve(),
            errorTitle = Translator.Get("Ui:ErrorTitle").Resolve(),
            error = Translator.Get("Ui:UnhandledError").Resolve(),
            reload = Translator.Get("Ui:Reload").Resolve(),
            dismiss = Translator.Get("Ui:Dismiss").Resolve()
        });
    }
}
