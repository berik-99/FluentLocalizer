@implements IDisposable
@inject IJSRuntime JS

<button type="button" class="copy-button @Class @(_state == CopyState.Copied ? "is-copied" : null)" @onclick="CopyAsync" aria-label="@(AriaLabel ?? Label ?? T["Ui:Copy"])">
    <svg class="copy-icon" viewBox="0 0 16 16" aria-hidden="true" focusable="false">
        @if (_state == CopyState.Copied)
        {
            <path d="M3.5 8.5l3 3 6-7" />
        }
        else
        {
            <rect x="5.5" y="5.5" width="8" height="8" rx="1.5" /><path d="M10.5 3.5v-.5a1 1 0 0 0-1-1h-6a1 1 0 0 0-1 1v6a1 1 0 0 0 1 1h.5" />
        }
    </svg>
    @if (ShowLabel)
    {
        <span>@(_state switch { CopyState.Copied => T["Ui:Copied"], CopyState.Failed => T["Ui:CopyFailed"], _ => Label ?? T["Ui:Copy"] })</span>
    }
</button>
<span class="sr-only" role="status">@(_state switch { CopyState.Copied => T["Ui:CopiedStatus"], CopyState.Failed => T["Ui:ClipboardUnavailable"], _ => "" })</span>

@code {
    [CascadingParameter] private System.Globalization.CultureInfo? SiteCulture { get; set; }

    [Parameter, EditorRequired] public string Text { get; set; } = string.Empty;
    [Parameter] public string? Label { get; set; }
    [Parameter] public bool ShowLabel { get; set; } = true;
    [Parameter] public string? AriaLabel { get; set; }
    [Parameter] public string? Class { get; set; }

    private enum CopyState { Idle, Copied, Failed }

    private CopyState _state;
    private CancellationTokenSource? _reset;

    private async Task CopyAsync()
    {
        try
        {
            await JS.InvokeVoidAsync("fluentSite.copyText", Text);
            _state = CopyState.Copied;
        }
        catch (JSException)
        {
            _state = CopyState.Failed;
        }

        _reset?.Cancel();
        _reset = new CancellationTokenSource();
        try
        {
            await Task.Delay(2000, _reset.Token);
            _state = CopyState.Idle;
        }
        catch (TaskCanceledException) { }
    }

    public void Dispose() => _reset?.Cancel();
}
