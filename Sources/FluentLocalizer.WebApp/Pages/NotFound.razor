@page "/not-found"
@layout MainLayout

<PageTitle>@Translator.Get("Ui:NotFoundTitle")</PageTitle>
<section class="shell not-found">
    <h1>@Translator.Get("Ui:NotFound")</h1>
    <p>@Translator.Get("Ui:NotFoundHelp")</p>
    <NavLink class="button button-primary" href="">@Translator.Get("Ui:BackHome") <span aria-hidden="true">↗</span></NavLink>
</section>

@code {
    [CascadingParameter] private System.Globalization.CultureInfo SiteCulture { get; set; } = System.Globalization.CultureInfo.CurrentUICulture;
}
