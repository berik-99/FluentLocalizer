@page "/docs/{*Path}"
@inject NavigationManager Navigation

@* Serves every documentation set from DocsSets: docs/{scope}/v{major}/{page}. Shorter and older addresses lead to the latest set. *@
@if (_set is not null && _page is not null)
{
    @* Keyed by address and fixed: the page being left must never re-render with the next page's set. *@
    <CascadingValue @key="_address" Value="_set" IsFixed="true">
        <DynamicComponent Type="_page.Component" />
    </CascadingValue>
}
else if (_missing)
{
    <NotFound />
}

@code {
    [Parameter] public string? Path { get; set; }

    private DocsSet? _set;
    private DocsPageInfo? _page;
    private bool _missing;
    private string? _address;

    protected override void OnParametersSet()
    {
        var address = Navigation.ToBaseRelativePath(Navigation.Uri);
        var fragment = address.Contains('#') ? address[(address.IndexOf('#') + 1)..] : "";
        // Each page and query gets its own component, so the API reference reads the requested version again.
        _address = address.Split('#')[0];
        var segments = (Path ?? "").Split('/', StringSplitOptions.RemoveEmptyEntries);
        (_set, _page, _missing) = (null, null, false);

        if (segments.Length == 0 || !DocsSets.ScopeIds.Contains(segments[0]))
        {
            // Addresses from before the documentation was versioned, such as docs/templates or docs/api#api-translator.
            Redirect(DocsSets.LegacyRoute(string.Join('/', segments), fragment));
            return;
        }

        var set = segments.Length > 1 ? DocsSets.Find(segments[0], segments[1]) : null;
        if (set is null)
        {
            // docs/core and docs/core/templates open the latest major version.
            var latest = DocsSets.Latest(segments[0]);
            var page = latest.FindPath(string.Join('/', segments.Skip(1)));
            Redirect(page is null ? null : latest.RouteOf(page) + (fragment.Length > 0 ? "#" + fragment : ""));
            return;
        }

        var path = string.Join('/', segments.Skip(2));
        var found = set.FindPath(path);
        if (found is null && path.Length == 0)
        {
            // A set without a page at its root opens on its first page.
            Redirect(set.RouteOf(set.Pages[0]));
            return;
        }
        _set = set;
        _page = found;
        _missing = found is null;
    }

    private void Redirect(string? route)
    {
        if (route is null) _missing = true;
        else Navigation.NavigateTo(route, replace: true);
    }
}
