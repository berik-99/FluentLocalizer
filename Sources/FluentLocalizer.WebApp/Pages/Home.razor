@page "/"

@using FluentLocalizer
@implements IAsyncDisposable
@inject IJSRuntime JS
@inject ITranslationStore Store

<PageTitle>@Translator.Get("Ui:HomeTitle")</PageTitle>

<section class="hero">
    <div class="shell hero-grid">
        <div class="hero-copy">
            <div class="pill"><span class="status-dot"></span> @Translator.Get("Ui:OpenSource").WithCase(LetterCase.Upper)</div>
            <h1><RichText Text="@Translator.Get("Ui:HeroTitle")" /></h1>
            <p class="hero-lede">@Translator.Get("Ui:HeroDescription")</p>
            <div class="hero-actions">
                <NavLink class="button button-primary" href="playground">@Translator.Get("Ui:TryPlayground") <span aria-hidden="true">↗</span></NavLink>
                <NavLink class="button button-ghost" href="@DocsSets.Latest(DocsSets.DefaultScope).Route">@Translator.Get("Ui:ReadDocs") <span aria-hidden="true">→</span></NavLink>
            </div>
            <div class="hero-meta"><span>@Translator.Get("Ui:Licensed")</span><span class="meta-divider"></span><span><RichText Text="@Translator.Get("Ui:Powered")" /></span><span class="meta-divider"></span><span>@Translator.Get("Ui:BlazorReady")</span></div>
        </div>
        <div class="hero-visual" role="img" aria-label="@Translator.Get("Ui:HeroVisual")">
            <div class="code-window" aria-hidden="true">
                <div class="window-top"><span class="window-dots"><i></i><i></i><i></i></span><span>Program.cs</span><span class="window-csharp">C#</span></div>
                <pre><code><span class="code-muted">// Translate with a fluent API</span>
<span class="code-keyword">var</span> greeting = translator
    .Get(<span class="code-string">"Demo:Welcome"</span>)
    .WithCulture(<span class="code-string">"<span class="culture-swap @SwapClass" @key="_displayCulture">@_displayCulture</span>"</span>)
    .WithArg(<span class="code-string">"name"</span>, <span class="code-string">"Ada"</span>)
    .Resolve();</code></pre>
                <div class="code-output">
                    <span class="output-label">@Translator.Get("Ui:Output").WithCase(LetterCase.Upper) <span class="output-led @(_typing ? "is-busy" : null)"></span></span>
                    <strong class="typed-output @(_typing ? "is-typing" : null)">@_displayText<span class="typing-caret"></span></strong>
                    <span class="output-locale"><span class="culture-swap @SwapClass" @key="_displayCulture">@_displayCulture</span></span>
                </div>
            </div>
            <span class="visual-caption">@Translator.Get("Ui:WriteOnce").WithCase(LetterCase.Upper)</span>
        </div>
    </div>
</section>

<section class="features section-padding" id="features">
    <div class="shell">
        <div class="section-intro">
            <div><span class="eyebrow">@Translator.Get("Ui:Why").WithCase(LetterCase.Upper)</span><h2>@Translator.Get("Ui:Everything")<br /><span>@Translator.Get("Ui:NothingExtra")</span></h2></div>
            <p>@Translator.Get("Ui:FeaturesDescription")</p>
        </div>
        <div class="feature-grid">
            @foreach (var (feature, index) in Features.Select((feature, index) => (feature, index)))
            {
                <article class="feature-card">
                    <span class="feature-icon icon-@feature.Tone" aria-hidden="true">@feature.Icon</span>
                    <span class="feature-number">@((index + 1).ToString("00"))</span>
                    <h3>@feature.Title</h3>
                    <p>@feature.Description</p>
                </article>
            }
        </div>
    </div>
</section>

<section class="flow-section section-padding">
    <div class="shell flow-grid">
        <div>
            <span class="eyebrow">@Translator.Get("Ui:Workflow").WithCase(LetterCase.Upper)</span>
            <h2>@Translator.Get("Ui:FlowTitle")<br /><span>@Translator.Get("Ui:FlowAccent")</span></h2>
            <p>@Translator.Get("Ui:WorkflowDescription")</p>
            <NavLink class="text-link" href="playground">@Translator.Get("Ui:ExplorePlayground") <span aria-hidden="true">↗</span></NavLink>
        </div>
        <ol class="flow-steps">
            <li class="flow-step"><span>01</span><div><h3>@Translator.Get("Ui:StoreTemplate")</h3><p><code>"@Store.GetTemplate("Demo:Items", SiteCulture)"</code></p></div></li>
            <li class="flow-step"><span>02</span><div><h3>@Translator.Get("Ui:BuildRequest")</h3><p><code>.Get("Demo:Items").Pluralize(3)</code></p></div></li>
            <li class="flow-step"><span>03</span><div><h3>@Translator.Get("Ui:ResolveMessage")</h3><p class="flow-result">@Translator.Get("Demo:Items").Pluralize(3)</p></div></li>
        </ol>
    </div>
</section>

<section class="packages section-padding" id="packages">
    <div class="shell">
        <div class="section-intro">
            <div><span class="eyebrow">@Translator.Get("Ui:Ecosystem").WithCase(LetterCase.Upper)</span><h2>@Translator.Get("Ui:StartSmall")<br /><span>@Translator.Get("Ui:AddNeeded")</span></h2></div>
            <p>@Translator.Get("Ui:PackagesDescription")</p>
        </div>
        <div class="package-list">
            @foreach (var (package, index) in Packages.Select((package, index) => (package, index)))
            {
                var command = $"dotnet add package {package.Id}";
                <article class="package-card">
                    <div class="package-index">@((index + 1).ToString("00")) / @package.Category</div>
                    <div class="package-info">
                        <h3>@package.Id</h3>
                        <p>@package.Description</p>
                        <div class="install-command"><code>@command</code><CopyButton Text="@command" ShowLabel="false" AriaLabel="@Translator.Get("Ui:CopyInstall").WithArg("package", package.Id)" /></div>
                    </div>
                    <div class="package-end">
                        <span class="version">v@(SiteLinks.PackageVersion)</span>
                        <a href="@SiteLinks.NuGet(package.Id)" target="_blank" rel="noopener noreferrer" aria-label="@Translator.Get("Ui:OnNuGet").WithArg("package", package.Id)">↗</a>
                    </div>
                </article>
            }
        </div>
        <p class="package-note">@Translator.Get("Ui:Versions")</p>
    </div>
</section>

<section class="cta-section">
    <div class="shell cta-inner">
        <div><span class="eyebrow">@Translator.Get("Ui:Ready").WithCase(LetterCase.Upper)</span><h2>@Translator.Get("Ui:EveryMessage")<br /><em>@Translator.Get("Ui:AtHome")</em></h2><p>@Translator.Get("Ui:Experiment")</p></div>
        <NavLink class="button button-dark" href="playground">@Translator.Get("Ui:OpenPlayground") <span aria-hidden="true">↗</span></NavLink>
    </div>
</section>

@code {
    [CascadingParameter] private System.Globalization.CultureInfo SiteCulture { get; set; } = System.Globalization.CultureInfo.CurrentUICulture;

    private static readonly string[] Cultures = ["en-US", "it-IT", "fr-FR", "de-DE", "es-ES"];

    private Feature[] Features =>
    [
        new("{ }", "lime", Translator.Get("Ui:FluentDesign"), Translator.Get("Ui:FluentDescription")),
        new("#", "peach", Translator.Get("Ui:Nuance"), Translator.Get("Ui:NuanceDescription")),
        new("◎", "blue", Translator.Get("Ui:CultureFallback"), Translator.Get("Ui:CultureDescription")),
        new("↗", "purple", Translator.Get("Ui:Extend"), Translator.Get("Ui:ExtendDescription"))
    ];

    private Package[] Packages =>
    [
        new("FluentLocalizer", Translator.Get("Ui:Core").WithCase(LetterCase.Upper), Translator.Get("Ui:CoreDescription")),
        new("FluentLocalizer.Store.Json", Translator.Get("Ui:Storage").WithCase(LetterCase.Upper), Translator.Get("Ui:StorageDescription")),
        new("FluentLocalizer.Extensions.DependencyInjection", Translator.Get("Ui:Integration").WithCase(LetterCase.Upper), Translator.Get("Ui:IntegrationDescription"))
    ];

    // Timings of the hero greeting animation, in milliseconds.
    private const int HoldDelay = 2400, EraseDelay = 30, SwapOutDelay = 220, SwapInDelay = 260, TypeDelay = 60;

    private readonly CancellationTokenSource _animationCancellation = new();
    private Task? _animationTask;
    private string _displayCulture = "it-IT";
    private string _displayText = string.Empty;
    private bool _typing;
    private bool _swappingOut;

    private string? SwapClass => _swappingOut ? "is-leaving" : null;

    protected override void OnInitialized()
    {
        _displayCulture = Cultures.First(culture => culture.StartsWith(SiteCulture.TwoLetterISOLanguageName + "-", StringComparison.OrdinalIgnoreCase));
        _displayText = ResolveGreeting(_displayCulture);
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender && !await JS.InvokeAsync<bool>("fluentSite.prefersReducedMotion"))
            _animationTask = AnimateGreetingAsync(_animationCancellation.Token);
    }

    private string ResolveGreeting(string culture) => Translator.Get("Demo:Welcome")
        .WithCulture(culture)
        .WithArg("name", "Ada")
        .Resolve();

    private async Task AnimateGreetingAsync(CancellationToken cancellationToken)
    {
        var index = Array.IndexOf(Cultures, _displayCulture);
        try
        {
            while (!cancellationToken.IsCancellationRequested)
            {
                await Task.Delay(HoldDelay, cancellationToken);

                _typing = true;
                var previous = _displayText;
                for (var length = previous.Length - 1; length >= 0; length--)
                    await RenderAsync(() => _displayText = previous[..length], EraseDelay, cancellationToken);

                // The culture slides out, then the re-keyed element slides in with the new value.
                await RenderAsync(() => _swappingOut = true, SwapOutDelay, cancellationToken);
                index = (index + 1) % Cultures.Length;
                await RenderAsync(() => (_swappingOut, _displayCulture) = (false, Cultures[index]), SwapInDelay, cancellationToken);

                var next = ResolveGreeting(_displayCulture);
                for (var length = 1; length <= next.Length; length++)
                    await RenderAsync(() => _displayText = next[..length], TypeDelay, cancellationToken);
                _typing = false;
                await InvokeAsync(StateHasChanged);
            }
        }
        catch (OperationCanceledException) { }
    }

    private async Task RenderAsync(Action change, int delay, CancellationToken cancellationToken)
    {
        change();
        await InvokeAsync(StateHasChanged);
        await Task.Delay(delay, cancellationToken);
    }

    public async ValueTask DisposeAsync()
    {
        _animationCancellation.Cancel();
        if (_animationTask is not null)
            await _animationTask;
        _animationCancellation.Dispose();
    }

    private sealed record Feature(string Icon, string Tone, string Title, string Description);

    private sealed record Package(string Id, string Category, string Description);
}
