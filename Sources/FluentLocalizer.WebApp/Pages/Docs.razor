@page "/docs"
@implements IAsyncDisposable
@inject IJSRuntime JS

<PageTitle>@Translator.Get("Ui:DocsTitle")</PageTitle>

<section class="docs-hero">
    <div class="shell">
        <h1>@Translator.Get("Ui:BuildMessages")<br /><em>@Translator.Get("Ui:Travel")</em></h1>
        <p>@Translator.Get("Ui:DocsDescription")</p>
    </div>
</section>

<div class="shell docs-grid">
    <aside class="docs-sidebar" aria-label="@Translator.Get("Ui:DocsSections")">
        <span class="eyebrow">@Translator.Get("Ui:OnPage").WithCase(LetterCase.Upper)</span>
        <nav @ref="_sidebar">
            @foreach (var (id, title) in Sections)
            {
                <a href="docs#@id">@title</a>
            }
        </nav>
    </aside>

    <article class="docs-content">
        <section id="quick-start" class="docs-section">
            <span class="eyebrow">@Translator.Get("Ui:FirstSteps").WithCase(LetterCase.Upper)</span>
            <h2>@Translator.Get("Ui:QuickStart")</h2>
            <p><RichText Text="@Translator.Get("Ui:QuickStartIntro")" /></p>
            <pre><code>dotnet add package FluentLocalizer</code></pre>
            <p><RichText Text="@Translator.Get("Ui:SmallStore")" /></p>
            <pre><code>using FluentLocalizer;
using System.Globalization;

public sealed class InMemoryStore : ITranslationStore
{
    public string? GetTemplate(string key, CultureInfo culture)
        =&gt; key == "welcome" ? "Ciao, {name}!" : null;

    public Task&lt;string?&gt; GetTemplateAsync(
        string key, CultureInfo culture,
        CancellationToken cancellationToken = default)
        =&gt; Task.FromResult(GetTemplate(key, culture));
}

var translator = new Translator(new InMemoryStore());</code></pre>
            <p>@Translator.Get("Ui:ResolveExample")</p>
            <pre><code>var message = translator.Get("welcome")
    .WithArg("name", "Ada")
    .Resolve();</code></pre>
            <p class="docs-note"><RichText Text="@Translator.Get("Ui:DefaultCulture")" /></p>
            <p><RichText Text="@Translator.Get("Ui:AsyncResolve")" /></p>
        </section>

        <section id="icu-syntax" class="docs-section">
            <span class="eyebrow">@Translator.Get("Ui:TemplatesEyebrow").WithCase(LetterCase.Upper)</span>
            <h2>@Translator.Get("Ui:Patterns")</h2>
            <p><RichText Text="@Translator.Get("Ui:PatternsDescription")" /></p>
            <div class="docs-patterns"><div><strong>@Translator.Get("Ui:Placeholder")</strong><code>Hello, {name}!</code><p><RichText Text="@Translator.Get("Ui:InsertArgument")" /></p></div><div><strong>@Translator.Get("Ui:Plural")</strong><code>{quantity, plural, one{# item} other{# items}}</code><p><RichText Text="@Translator.Get("Ui:PluralBranch")" /></p></div><div><strong>@Translator.Get("Ui:Select")</strong><code>{gender, select, female{She} male{He} other{They}}</code><p><RichText Text="@Translator.Get("Ui:SelectBranch")" /></p></div></div>
            <p><RichText Text="@Translator.Get("Ui:PatternOther")" /></p>
        </section>

        <section id="fluent-api" class="docs-section">
            <span class="eyebrow">@Translator.Get("Ui:RequestsEyebrow").WithCase(LetterCase.Upper)</span>
            <h2>@Translator.Get("Ui:FluentApi")</h2>
            <p><RichText Text="@Translator.Get("Ui:RequestsDescription")" /></p>
            <div class="docs-methods"><div><code>.Get(key)</code><span>@Translator.Get("Ui:ChooseKey")</span></div><div><code>.WithArg(name, value)</code><span>@Translator.Get("Ui:SupplyArgument")</span></div><div><code>.Pluralize(number)</code><span><RichText Text="@Translator.Get("Ui:PluralizeArgument")" /></span></div><div><code>.Genderize(gender)</code><span><RichText Text="@Translator.Get("Ui:GenderizeArgument")" /></span></div><div><code>.WithCase(letterCase)</code><span><RichText Text="@Translator.Get("Ui:TransformResolved")" /></span></div><div><code>.WithCulture(culture)</code><span>@Translator.Get("Ui:ChooseCulture")</span></div><div><code>.Resolve()</code><span>@Translator.Get("Ui:ReturnSync")</span></div><div><code>.ResolveAsync()</code><span>@Translator.Get("Ui:ResolveAsync")</span></div></div>
            <pre><code>var summary = translator.Get("items")
    .Pluralize(3)
    .WithCase(LetterCase.Upper)
    .Resolve();</code></pre>
            <h3>@Translator.Get("Ui:CultureSettings")</h3>
            <p><RichText Text="@Translator.Get("Ui:ChangeCulture")" /></p>
            <pre><code>var culture = CultureInfo.GetCultureInfo("it-IT");
CultureInfo.CurrentUICulture = culture;
CultureInfo.CurrentCulture = culture;

var message = translator.Get("welcome")
    .WithArg("name", "Ada")
    .Resolve();</code></pre>
            <p><RichText Text="@Translator.Get("Ui:CultureScope")" /></p>
            <p><RichText Text="@Translator.Get("Ui:CultureDefaults")" /></p>
            <p><RichText Text="@Translator.Get("Ui:ForceCulture")" /></p>
            <pre><code>var subject = translator.Get("Email:Subject")
    .WithCulture(recipientCulture)
    .Resolve();</code></pre>
        </section>

        <section id="options" class="docs-section">
            <span class="eyebrow">@Translator.Get("Ui:BehaviorEyebrow").WithCase(LetterCase.Upper)</span>
            <h2>@Translator.Get("Ui:OptionsFallback")</h2>
            <p><RichText Text="@Translator.Get("Ui:OptionsDescription")" /></p>
            <pre><code>var options = new TranslationOptions
{
    MissingKeyBehavior = MissingTranslationBehavior.ReturnConfiguredValue,
    MissingKeyFallbackValue = "Missing '{key}' for '{culture}'.",
    FormattingErrorBehavior = FormattingErrorBehavior.ThrowException,
    DefaultArguments = new Dictionary&lt;string, object?&gt;
    {
        ["name"] = "Ada"
    }
};

var translator = new Translator(store, options);</code></pre>
            <p><RichText Text="@Translator.Get("Ui:JsonFallback")" /></p>
        </section>

        <section id="json-stores" class="docs-section">
            <span class="eyebrow">@Translator.Get("Ui:StorageEyebrow").WithCase(LetterCase.Upper)</span>
            <h2>@Translator.Get("Ui:JsonStores")</h2>
            <p><RichText Text="@Translator.Get("Ui:JsonIntro")" /></p>
            <pre><code>dotnet add package FluentLocalizer.Store.Json</code></pre>
            <pre><code>{
  "Home": {
    "Welcome": "Hello, {name}!"
  }
}</code></pre>
            <div class="docs-store-grid"><div><h3>JsonFileStore</h3><p><RichText Text="@Translator.Get("Ui:FileStore")" /></p></div><div><h3>EmbeddedJsonStore</h3><p><RichText Text="@Translator.Get("Ui:EmbeddedStore")" /></p></div><div><h3>HttpJsonStore</h3><p><RichText Text="@Translator.Get("Ui:HttpStore")" /></p></div></div>
            <p><RichText Text="@Translator.Get("Ui:HttpUsage")" /></p>
            <pre><code>using var store = new HttpJsonStore(httpClient,
    new HttpJsonStoreOptions { ResourcesPath = "locales" });

var translator = new Translator(store);
var message = await translator.Get("Home:Welcome")
    .WithArg("name", "Ada")
    .ResolveAsync();</code></pre>
        </section>

        <section id="json-files" class="docs-section">
            <span class="eyebrow">@Translator.Get("Ui:FilesEyebrow").WithCase(LetterCase.Upper)</span>
            <h2>@Translator.Get("Ui:JsonFiles")</h2>
            <p><RichText Text="@Translator.Get("Ui:JsonKeys")" /></p>
            <pre><code>{
  "Welcome": "Hello {name}!",
  "Checkout": {
    "Title": "Your cart",
    "Items": "{quantity, plural, one {# item} other {# items}}"
  }
}</code></pre>
            <p><RichText Text="@Translator.Get("Ui:JsonKeyRules")" /></p>
            <h3>@Translator.Get("Ui:Namespaces")</h3>
            <p><RichText Text="@Translator.Get("Ui:NamespaceIntro")" /></p>
            <div class="docs-files">
                <figure><figcaption><code>it-IT.json</code></figcaption><pre><code>{
  "common": {
    "Buttons": { "Save": "Salva" }
  }
}</code></pre></figure>
                <figure><figcaption><code>it-IT.common.json</code></figcaption><pre><code>{
  "Buttons": { "Save": "Salva" }
}</code></pre></figure>
            </div>
            <p><RichText Text="@Translator.Get("Ui:NamespaceFiles")" /></p>
            <h3>@Translator.Get("Ui:LookupOrder")</h3>
            <p><RichText Text="@Translator.Get("Ui:LookupDescription")" /></p>
            <h3>@Translator.Get("Ui:RecommendedLayout")</h3>
            <p><RichText Text="@Translator.Get("Ui:LayoutDescription")" /></p>
            <pre><code>Locales/
  en.json
  en-GB.json
  it.json
  it.checkout.json</code></pre>
            <p><RichText Text="@Translator.Get("Ui:RegionalWarning")" /></p>
            <p><RichText Text="@Translator.Get("Ui:SiteLayout")" /></p>
        </section>

        <section id="dependency-injection" class="docs-section">
            <span class="eyebrow">@Translator.Get("Ui:IntegrationEyebrow").WithCase(LetterCase.Upper)</span>
            <h2>@Translator.Get("Ui:DependencyInjection")</h2>
            <p><RichText Text="@Translator.Get("Ui:InjectionDescription")" /></p>
            <pre><code>dotnet add package FluentLocalizer.Extensions.DependencyInjection</code></pre>
            <pre><code>services.AddFluentLocalizer(options =&gt;
{
    options.MissingKeyBehavior =
        MissingTranslationBehavior.ReturnConfiguredValue;
    options.MissingKeyFallbackValue = "[{key}]";
})
.WithStore(new JsonFileStore(new JsonFileStoreOptions
{
    ResourcesPath = "Locales",
    FallbackCulture = "en-US"
}));</code></pre>
        </section>

        <section id="api-reference" class="docs-section">
            <span class="eyebrow">@Translator.Get("Ui:ReferenceEyebrow").WithCase(LetterCase.Upper)</span>
            <h2>@Translator.Get("Ui:ApiReference")</h2>
            <p>@Translator.Get("Ui:ApiDescription")</p>
            <p><NavLink href="docs/api">@Translator.Get("Ui:OpenApiReference")</NavLink></p>
        </section>

        <section id="more-resources" class="docs-section">
            <span class="eyebrow">@Translator.Get("Ui:NextSteps").WithCase(LetterCase.Upper)</span>
            <h2>@Translator.Get("Ui:MoreResources")</h2>
            <p>@Translator.Get("Ui:ResourcesDescription")</p>
            <div class="docs-links">
                <a href="@SiteLinks.Readme("FluentLocalizer.Core")" target="_blank" rel="noopener noreferrer">@Translator.Get("Ui:CoreGuide") <span aria-hidden="true">↗</span></a>
                <a href="@SiteLinks.Readme("FluentLocalizer.Store.Json")" target="_blank" rel="noopener noreferrer">@Translator.Get("Ui:JsonGuide") <span aria-hidden="true">↗</span></a>
                <a href="@SiteLinks.Readme("FluentLocalizer.Extensions.DependencyInjection")" target="_blank" rel="noopener noreferrer">@Translator.Get("Ui:InjectionGuide") <span aria-hidden="true">↗</span></a>
                <a href="@SiteLinks.Examples" target="_blank" rel="noopener noreferrer">@Translator.Get("Ui:Examples") <span aria-hidden="true">↗</span></a>
            </div>
        </section>
    </article>
</div>

@code {
    [CascadingParameter] private System.Globalization.CultureInfo SiteCulture { get; set; } = System.Globalization.CultureInfo.CurrentUICulture;

    private (string Id, string Title)[] Sections =>
    [
        ("quick-start", Translator.Get("Ui:QuickStart")), ("icu-syntax", Translator.Get("Ui:IcuSyntax")), ("fluent-api", Translator.Get("Ui:FluentApiSection")),
        ("options", Translator.Get("Ui:OptionsFallback")), ("json-stores", Translator.Get("Ui:JsonStoresSection")), ("json-files", Translator.Get("Ui:JsonFilesSection")),
        ("dependency-injection", Translator.Get("Ui:DependencyInjection")), ("api-reference", Translator.Get("Ui:ApiReference")),
        ("more-resources", Translator.Get("Ui:MoreResources"))
    ];

    private ElementReference _sidebar;
    private IJSObjectReference? _sectionWatcher;

    // Highlights the sidebar link of the section being read.
    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
            _sectionWatcher = await JS.InvokeAsync<IJSObjectReference>("fluentSite.watchSections", _sidebar);
    }

    public async ValueTask DisposeAsync()
    {
        if (_sectionWatcher is null) return;
        try
        {
            await _sectionWatcher.InvokeVoidAsync("dispose");
            await _sectionWatcher.DisposeAsync();
        }
        catch (JSDisconnectedException) { }
    }
}
