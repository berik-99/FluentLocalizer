@inject IJSRuntime JS
@inject NavigationManager Navigation

<PageTitle>@Translator.Get("Ui:ApiTitle")</PageTitle>

<section class="docs-hero">
    <div class="shell">
        <DocsOutdated PageKey="Api" />
        <h1>@Translator.Get("Ui:ApiReference")</h1>
        <p><RichText Text="@Translator.Get(DescriptionKey)" /></p>
        <dl class="api-stats">
            <div><dt>@Translator.Get("Ui:ApiPackages")</dt><dd>@Packages.Length</dd></div>
            <div><dt>@Translator.Get("Ui:ApiTypesStat")</dt><dd>@AvailableTypes.Length</dd></div>
            <div><dt>@Translator.Get("Ui:ApiMembersStat")</dt><dd>@AvailableTypes.Sum(type => MembersOf(type).Count())</dd></div>
            <div><dt>@Translator.Get("Ui:ApiVersion")</dt><dd>@_version</dd></div>
        </dl>
    </div>
</section>

<div class="shell docs-grid api-grid">
    <aside class="docs-sidebar api-sidebar">
        <nav class="api-index" aria-label="@Translator.Get("Ui:ApiTypes")">
            @foreach (var package in FilteredTypes.GroupBy(type => type.Package))
            {
                <span class="api-index-package">@WrapIdentifier(package.Key)</span>
                @foreach (var type in package)
                {
                    <a href="@TypeLink(type)" class="@(type.IsDeprecatedIn(_version) ? "is-deprecated" : null)">
                        <span class="api-glyph api-kind-@type.KindStyle" title="@type.Kind" aria-hidden="true">@char.ToUpperInvariant(type.KindStyle[0])</span>
                        <span>@WrapIdentifier(type.Name)</span>
                    </a>
                }
            }
        </nav>
    </aside>

    <article class="docs-content">
        @* The same toolbar as the guides: scope tabs and version, then the search of the reference. *@
        <div class="docs-toolbar">
            <div class="docs-toolbar-row">
                <DocsScopeTabs PageKey="Api" />
                <div class="docs-version">
                    <span class="docs-version-label" id="api-version-label">@Translator.Get("Ui:ApiVersion")</span>
                    <Dropdown TValue="string" Id="api-version" LabelledBy="api-version-label" Options="VersionOptions" Value="@_version" ValueChanged="ChangeVersion" />
                </div>
            </div>
            <label class="sr-only" for="api-search">@Translator.Get("Ui:ApiSearch")</label>
            <input id="api-search" type="search" placeholder="@Translator.Get("Ui:ApiSearch")" @bind="_query" @bind:event="oninput" />
        </div>

        @* What each version changed is listed in the changelog, shared by every package. *@
        <p class="api-release">
            <span class="api-release-date">@(Release.Date is { } date ? Translator.Get("Ui:ApiReleasedOn").WithArg("date", date) : Translator.Get("Ui:ApiNotReleased"))</span>
            <a href="@($"changelog?scope={Set.ScopeId}#{Changelog.Anchor(Set.ScopeId, _version)}")">@Translator.Get("Ui:ApiSeeChangelog").WithArg("version", _version) <span aria-hidden="true">→</span></a>
        </p>

        <p class="api-language">@Translator.Get("Ui:ApiLanguage")</p>

        @foreach (var package in FilteredTypes.GroupBy(type => type.Package))
        {
            <section class="api-package" aria-labelledby="@($"package-{package.Key}")">
                <header class="api-package-head">
                    <span class="eyebrow">@Translator.Get("Ui:ApiPackage").WithCase(LetterCase.Upper)</span>
                    <h2 id="@($"package-{package.Key}")">@WrapIdentifier(package.Key)</h2>
                    <p>@Translator.Get(PackageSummaryKey(package.Key))</p>
                    <div class="api-install">
                        <code>dotnet add package @package.Key@(IsPublished ? $" --version {_version}" : "")</code>
                        <a href="@(SiteLinks.NuGet(package.Key) + (IsPublished ? $"/{_version}" : ""))" target="_blank" rel="noopener noreferrer">NuGet <span aria-hidden="true">↗</span></a>
                    </div>
                </header>

                @foreach (var type in package)
                {
                    var deprecated = type.IsDeprecatedIn(_version);
                    <article id="@type.Id" class="api-type" aria-labelledby="@($"{type.Id}-title")">
                        <header class="api-type-head">
                            <span class="api-kind api-kind-@type.KindStyle">@type.Kind</span>
                            <h3 id="@($"{type.Id}-title")">@WrapIdentifier(type.Name)</h3>
                            <span class="api-since">@Translator.Get("Ui:ApiSince").WithArg("version", type.Introduced)</span>
                            @if (deprecated)
                            {
                                <span class="api-deprecated">@Translator.Get("Ui:ApiDeprecated")</span>
                            }
                            <a class="api-source" href="@($"{SiteLinks.Repository}/blob/{Release.SourceRevision}/{type.Source}")" target="_blank" rel="noopener noreferrer">@Translator.Get("Ui:ApiSource") <span aria-hidden="true">↗</span></a>
                        </header>

                        <pre class="api-code api-declaration"><code>@ApiReference.Highlight(type.Declaration, type.Name, declaration: true, link: TypeLink)</code></pre>

                        <dl class="api-meta">
                            <div><dt>@Translator.Get("Ui:ApiPackage")</dt><dd><code>@type.Package</code></dd></div>
                            <div><dt>@Translator.Get("Ui:ApiNamespace")</dt><dd><code>@type.Namespace</code></dd></div>
                        </dl>

                        @if (deprecated)
                        {
                            @Lifecycle(type)
                        }
                        <p class="api-summary" lang="en">@type.Summary</p>
                        @if (type.Remarks is not null)
                        {
                            <p class="api-remarks" lang="en">@type.Remarks</p>
                        }

                        @foreach (var group in MembersOf(type).GroupBy(member => ApiReference.GroupOf(type, member)).OrderBy(group => group.Key))
                        {
                            <section class="api-group">
                                <h4>@Translator.Get($"Ui:Api{group.Key}") <span class="api-count">@group.Count()</span></h4>
                                @if (group.Key == ApiMemberGroup.Values)
                                {
                                    // The value column appears only when the source declares values explicitly.
                                    var values = group.Select(member => (Member: member, Entry: ApiReference.EnumValue(member))).ToArray();
                                    var showValues = values.Any(value => value.Entry.Value.Length > 0);
                                    <table class="api-enum" lang="en">
                                        <thead>
                                            <tr>
                                                <th scope="col">@Translator.Get("Ui:ApiName")</th>
                                                @if (showValues)
                                                {
                                                    <th scope="col">@Translator.Get("Ui:ApiValue")</th>
                                                }
                                                <th scope="col">@Translator.Get("Ui:ApiDetails")</th>
                                            </tr>
                                        </thead>
                                        <tbody>
                                            @foreach (var (member, entry) in values)
                                            {
                                                <tr>
                                                    <th scope="row"><code>@entry.Name</code></th>
                                                    @if (showValues)
                                                    {
                                                        <td><code>@entry.Value</code></td>
                                                    }
                                                    <td>@MemberBadges(type, member)@member.Description</td>
                                                </tr>
                                            }
                                        </tbody>
                                    </table>
                                }
                                else
                                {
                                    <ul class="api-members" lang="en">
                                        @foreach (var member in group)
                                        {
                                            <li>
                                                <pre class="api-code"><code>@ApiReference.Highlight(member.Signature, type.Name, link: TypeLink)</code></pre>
                                                <p>@MemberBadges(type, member)@member.Description</p>
                                                @if (member.IsDeprecatedIn(_version))
                                                {
                                                    @Lifecycle(member)
                                                }
                                            </li>
                                        }
                                    </ul>
                                }
                            </section>
                        }
                    </article>
                }
            </section>
        }
        @if (FilteredTypes.Length == 0)
        {
            <p class="api-empty" role="status"><RichText Text="@Translator.Get("Ui:ApiNoResults")" /></p>
        }
    </article>
</div>

@code {
    [CascadingParameter] private System.Globalization.CultureInfo SiteCulture { get; set; } = System.Globalization.CultureInfo.CurrentUICulture;

    /// <summary>The documentation set being read: its scope's packages and the versions of its major release line.</summary>
    [CascadingParameter] private DocsSet Set { get; set; } = default!;

    private string[] Packages => Set.Scope.Packages;
    private string _query = "";
    private string _version = "";

    private ApiRelease Release => Set.Scope.Release(_version);
    private bool IsPublished => Release.Date is not null;
    private string DescriptionKey => "Ui:ApiDescription" + DocsSets.ScopeNameKey(Set.ScopeId)["Ui:Scope".Length..];

    // Every version of the scope, newest first; the latest published version and unpublished previews are labelled.
    private DropdownOption<string>[] VersionOptions => Enumerable.Reverse(Set.Scope.Versions).Select(release => new DropdownOption<string>(release.Version,
        release.Version == Set.Scope.LatestRelease ? Translator.Get("Ui:ApiLatest").WithArg("version", release.Version)
        : release.Date is null ? Translator.Get("Ui:ApiPreview").WithArg("version", release.Version)
        : release.Version)).ToArray();

    // The changelog links to a version with ?version=; otherwise the set's latest published version is shown.
    protected override void OnInitialized()
    {
        var requested = SiteLinks.QueryValue(Navigation.Uri, "version");
        _version = Set.Releases.Any(release => release.Version == requested) ? requested! : Set.LatestRelease;
    }

    // A version of another major release line opens the reference of its documentation set.
    private void ChangeVersion(string version)
    {
        if (Set.Releases.Any(release => release.Version == version))
        {
            _version = version;
            return;
        }
        var set = DocsSets.ForVersion(Set.ScopeId, version);
        Navigation.NavigateTo($"{set.RouteOf(set.ApiPage!)}?version={Uri.EscapeDataString(version)}");
    }

    // Types of this scope stay on this page and version; types of another scope open its latest reference.
    private string TypeLink(ApiType type) => type.Scope.Id == Set.ScopeId
        ? Navigation.ToBaseRelativePath(Navigation.Uri).Split('#')[0] + "#" + type.Id
        : DocsSets.ApiLink(type);

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender) await JS.InvokeVoidAsync("fluentSite.scrollToHash");
    }

    private RenderFragment MemberBadges(ApiType type, ApiMember member) => __builder =>
    {
        var since = member.IntroducedWith(type);
        if (since != type.Introduced)
        {
            <span class="api-since is-new">@Translator.Get("Ui:ApiSince").WithArg("version", since)</span>
        }
        if (member.IsDeprecatedIn(_version))
        {
            <span class="api-deprecated">@Translator.Get("Ui:ApiDeprecated")</span>
        }
    };

    // "Deprecated in 1.0.0. Use instead: A, B. Removal planned in 2.0.0."
    private RenderFragment Lifecycle(ApiEntry entry) => __builder =>
    {
        <div class="api-lifecycle">
            <strong>@Translator.Get("Ui:ApiDeprecatedIn").WithArg("version", entry.DeprecatedIn!)</strong>
            @if (entry.ReplacedBy.Length > 0)
            {
                <span>
                    @Translator.Get("Ui:ApiUseInstead")
                    @for (var index = 0; index < entry.ReplacedBy.Length; index++)
                    {
                        var replacement = entry.ReplacedBy[index];
                        var target = ApiReference.Types.FirstOrDefault(type => type.Name == replacement.Split('.')[0]);
                        @(index > 0 ? ", " : " ")
                        @if (target is not null && (target.Scope.Id != Set.ScopeId || target.IsAvailableIn(_version)))
                        {
                            <a href="@TypeLink(target)"><code>@replacement</code></a>
                        }
                        else
                        {
                            <code>@replacement</code>
                        }
                    }
                </span>
            }
            @if (entry.RemovedIn is { } removed)
            {
                <span>@Translator.Get(ApiVersion.Compare(removed, Set.Scope.LatestRelease) <= 0 ? "Ui:ApiRemovedIn" : "Ui:ApiRemovalPlanned").WithArg("version", removed)</span>
            }
        </div>
    };


    private IEnumerable<ApiMember> MembersOf(ApiType type) =>
        type.Members.Where(member => member.IsAvailableIn(_version, member.IntroducedWith(type)));

    // Allow line breaks between words in compound API names, while preserving the visible identifier.
    private static MarkupString WrapIdentifier(string value) => new(
        System.Text.RegularExpressions.Regex.Replace(
            System.Text.Encodings.Web.HtmlEncoder.Default.Encode(value),
            @"(?<=[a-z0-9])(?=[A-Z])|(?<=[A-Z])(?=[A-Z][a-z])|(?<=\.)",
            "<wbr>"));


    private static string PackageSummaryKey(string package) => package switch
    {
        "FluentLocalizer" => "Ui:ApiPackageCore",
        "FluentLocalizer.Store.Json" => "Ui:ApiPackageJson",
        _ => "Ui:ApiPackageDi"
    };

    private ApiType[] AvailableTypes => ApiReference.TypesIn(Set.Scope, _version);

    private ApiType[] FilteredTypes => AvailableTypes.Where(type =>
        (string.IsNullOrWhiteSpace(_query) ||
        type.Name.Contains(_query.Trim(), StringComparison.OrdinalIgnoreCase) ||
        type.Kind.Contains(_query.Trim(), StringComparison.OrdinalIgnoreCase) ||
        type.Namespace.Contains(_query.Trim(), StringComparison.OrdinalIgnoreCase) ||
        type.Package.Contains(_query.Trim(), StringComparison.OrdinalIgnoreCase) ||
        MembersOf(type).Any(member => member.Signature.Contains(_query.Trim(), StringComparison.OrdinalIgnoreCase))))
        .ToArray();
}
